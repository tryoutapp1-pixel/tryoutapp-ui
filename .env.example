# API origin only (no trailing /api). The app appends /api once.
# In development the Express backend defaults to port 3000.
VITE_API_ORIGIN=http://localhost:3000

# Midtrans Snap (client-side). Public client key only — never the server key.
# Must match the backend's MIDTRANS_CLIENT_KEY / MIDTRANS_IS_PRODUCTION.
VITE_MIDTRANS_CLIENT_KEY=
VITE_MIDTRANS_IS_PRODUCTION=false
